{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --workspaces --include-workspace-root --workspace backend",
  "buildCommand": "cd frontend && rm -f .env .env.local package-lock.json && npm install && npm install --no-save @rollup/rollup-linux-x64-gnu && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...route].js": {
      "includeFiles": "backend/src/sql/schema.sql",
      "maxDuration": 60
    },
    "api/cron/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/[...route]"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/financeiro",
      "destination": "/index.html"
    },
    {
      "source": "/agenda",
      "destination": "/index.html"
    },
    {
      "source": "/horarios",
      "destination": "/index.html"
    },
    {
      "source": "/servicos",
      "destination": "/index.html"
    },
    {
      "source": "/assinaturas",
      "destination": "/index.html"
    }
  ]
}
