{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --workspaces --include-workspace-root --workspace backend --workspace frontend --include=optional",
  "buildCommand": "npm install --workspace frontend --include=optional --no-save && npm run build --workspace frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...route].js": {
      "includeFiles": "backend/src/sql/schema.sql",
      "maxDuration": 60
    },
    "api/cron/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/agenda",
      "destination": "/index.html"
    },
    {
      "source": "/horarios",
      "destination": "/index.html"
    },
    {
      "source": "/servicos",
      "destination": "/index.html"
    },
    {
      "source": "/assinaturas",
      "destination": "/index.html"
    }
  ]
}
