{
  "name": "corte-certo-webapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20.x || 24.x"
  },
  "workspaces": [
    "backend",
    "frontend",
    "chatbot"
  ],
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c blue,green \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "chatbot:start": "npm --prefix chatbot start",
    "chatbot:install": "npm --prefix chatbot install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
